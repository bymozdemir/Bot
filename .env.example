# AL-SAT bot örnek yapılandırması. Gerçek sırları bu dosyaya yazmayın.
# Kopyalayıp .env yapabilirsiniz; .env Git tarafından yok sayılır.

# Paneli yalnızca bu cihazdan erişilebilir tutun.
HOST=127.0.0.1
PORT=8787
NODE_ENV=production

# Canlı işlem izinleri varsayılan olarak kapalıdır.
# Kullanıcı bilinçli şekilde etkinleştirmedikçe gerçek emir gönderilmez.
LIVE_TRADING_ENABLED=false
ALLOW_PRODUCTION_TRADING=false
ALLOW_BINANCE_TESTNET_TRADING=false
ALLOW_BINANCE_TR_TRADING=false
ALLOW_BTCTURK_TRADING=false
ALLOW_PARIBU_TRADING=false

# İsteğe bağlı bildirimler; değerleri boş bırakın ve kurulum sihirbazını kullanın.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_TERMUX=0
# HEALTHCHECK_URL=

# Sembol bazında eşzamanlı piyasa verisi toplama sınırı (1-8, varsayılan 4). Emirler paralelleştirilmez.
MARKET_DATA_CONCURRENCY=4
